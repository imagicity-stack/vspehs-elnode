rules_version = '2';

// ─────────────────────────────────────────────────────────────
// El-Node — Firestore security rules
// ─────────────────────────────────────────────────────────────
// A user's role is resolved from (in order): a custom auth claim, their
// `appUsers/{uid}` document, or the Super Admin email allowlist below. Roles
// gate write access by area. Tighten further before production (e.g. per-class
// teacher scoping, and replace the email allowlist with custom claims for all).
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Emails permitted to act as Super Admin without a provisioned profile.
    // KEEP IN SYNC with the NEXT_PUBLIC_SUPERADMIN_EMAILS env var. This is the
    // bootstrap that lets a freshly-signed-in Google admin read/write before any
    // appUsers/{uid} document exists.
    function adminEmails() {
      return ["dewesh@eldenheights.org", "contact.vsp@eldenheights.org"];
    }
    // Managed admins added in-app (appConfig/superadmins). Guarded so a missing
    // doc never errors the rule.
    function managedAdmins() {
      return exists(/databases/$(database)/documents/appConfig/superadmins)
        ? get(/databases/$(database)/documents/appConfig/superadmins).data.emails
        : [];
    }
    function isAllowlistedAdmin() {
      return isSignedIn() && (
        request.auth.token.email in adminEmails()
        || request.auth.token.email in managedAdmins()
      );
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/appUsers/$(request.auth.uid));
    }

    // Role resolution order: custom claim (set by the server for parents) →
    // appUsers profile document → "anon". Guarded so a missing profile never
    // errors the rule.
    function role() {
      return !isSignedIn() ? "anon"
        : request.auth.token.role != null ? request.auth.token.role
        : hasProfile()
          ? get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.role
          : "anon";
    }

    function isStaff() {
      return isAllowlistedAdmin() || role() in ["teacher", "accountant", "superadmin"];
    }

    function isAdmin() {
      return isAllowlistedAdmin() || role() == "superadmin";
    }

    function isFinance() {
      return isAllowlistedAdmin() || role() in ["accountant", "superadmin"];
    }

    // Throwaway collection used by the in-app diagnostics "write test".
    match /_diagnostics/{id} {
      allow read, write: if isSignedIn();
    }

    // App configuration — e.g. the managed Super Admin list. Any signed-in user
    // may read (login needs to check it); only admins may change it.
    match /appConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // App user profiles
    match /appUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isAdmin();
    }

    function isTeacher() {
      return role() == "teacher";
    }

    // The staff id carried on the caller's custom claim, or "" when absent.
    function myStaffId() {
      return request.auth.token.staffId != null ? request.auth.token.staffId : "";
    }

    // The student ids linked to a parent's profile.
    function myStudentIds() {
      return hasProfile()
        ? get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.studentIds
        : [];
    }

    // Read-mostly directories: any signed-in user may read; staff may write.
    match /students/{id}   { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /classes/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }
    // Subject master list — any signed-in user may read; only admins manage it.
    match /subjects/{id}   { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // Staff records are admin-managed, with one exception: a staff member may
    // stamp their own sign-in and password-change status on their own record —
    // and nothing else on it.
    match /staff/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
      allow update: if isStaff() && myStaffId() == id
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastLoginAt', 'passwordChangedAt', 'mustChangePassword']);
    }

    // Attendance, daily updates, homework, exams — teachers & admins write.
    match /attendance/{id}      { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /staffAttendance/{id} { allow read: if isStaff();    allow write: if isStaff(); }
    match /dailyUpdates/{id}    { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /homework/{id}        { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /exams/{id}           { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /examResults/{id}     { allow read: if isSignedIn(); allow write: if isStaff(); }

    // Finance — accountants & admins write.
    match /feeHeads/{id}    { allow read: if isSignedIn(); allow write: if isFinance(); }
    match /invoices/{id}    { allow read: if isSignedIn(); allow write: if isFinance(); }
    match /payments/{id}    { allow read: if isSignedIn(); allow write: if isFinance(); }
    match /concessions/{id} { allow read: if isSignedIn(); allow write: if isFinance(); }

    // Communications & calendar
    match /circulars/{id} { allow read: if isSignedIn(); allow write: if isStaff(); }
    match /events/{id}    { allow read: if isSignedIn(); allow write: if isStaff(); }

    // Staff self-service
    match /leaveRequests/{id} { allow read: if isStaff(); allow write: if isStaff(); }
    match /taskItems/{id}     { allow read: if isStaff(); allow write: if isStaff(); }

    // ─────────────────────────────────────────────────────────
    // Examination system
    // ─────────────────────────────────────────────────────────
    // The rules below are the real permission boundary. The UI hides what a
    // teacher may not touch, but only these stop a crafted request.

    // Sessions and the timetable are public to the school: parents and
    // students need them to see when a paper is. Only admins change them.
    match /academicSessions/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /examGroups/{id}       { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subjectExams/{id}     { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // Who teaches what. Staff read it (it drives their own scoping);
    // only an admin may allocate.
    match /teacherAssignments/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Grading rules — staff may read, only admins may change. A published
    // result carries its own copy of the bands, so editing a scale here can
    // never alter a report card already issued.
    match /gradeScales/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Marks. Never readable by parents — a draft sheet is not a result.
    // A teacher may only write the sheet for a paper they are allocated, and
    // only while it is unlocked; moving a sheet out of submitted/verified is
    // an admin action.
    match /examMarks/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        || (isTeacher()
            && teachesPaper(request.resource.data.classId, request.resource.data.subjectId)
            && request.resource.data.status in ['draft', 'submitted']
            && (!exists(/databases/$(database)/documents/examMarks/$(id))
                || resource.data.status in ['not-started', 'draft']));
      allow delete: if isAdmin();
    }

    // A teacher is allocated a paper when a teacherAssignments document exists
    // for their staff id, that class and that subject. The id is deterministic
    // precisely so this check is a single cheap lookup.
    function teachesPaper(classId, subjectId) {
      return exists(
        /databases/$(database)/documents/teacherAssignments/$(
          'ta-' + myStaffId() + '-' + classId + '-' + subjectId
        )
      );
    }

    // Published results. Staff read all; a parent reads only their own
    // children's. Nobody but an admin writes one — publishing is not a
    // client-side privilege.
    match /studentResults/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.studentId in myStudentIds());
      allow write: if isAdmin();
    }

    // Report card issue log and the audit trail: admin-owned. The audit trail
    // is append-only — an entry may never be edited or removed, or it would be
    // no record at all.
    match /reportCards/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Notifications are broadcast to a role; any signed-in user may read them
    // and mark one read, but only staff may raise one.
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isStaff()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isAdmin();
    }
  }
}
